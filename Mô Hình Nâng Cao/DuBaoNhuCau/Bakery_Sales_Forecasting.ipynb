 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Dự báo nhu cầu tiêu thụ nguyên vật liệu (Bakery Sales Forecasting)\n",
    "Đây là mô hình sử dụng mạng LSTM (Long Short-Term Memory) để dự báo nhu cầu bán hàng dựa trên dữ liệu chuỗi thời gian (Time Series)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "from sklearn.preprocessing import MinMaxScaler\n",
    "from tensorflow.keras.models import Sequential\n",
    "from tensorflow.keras.layers import LSTM, Dense, Dropout, Bidirectional\n",
    "from tensorflow.keras.callbacks import EarlyStopping, ReduceLROnPlateau\n",
    "import datetime\n",
    "import os\n",
    "import zipfile\n",
    "import glob\n",
    "\n",
    "# ĐỊNH NGHĨA CÁC THAM SỐ CƠ BẢN\n",
    "look_back = 30  # Số ngày dùng để dự báo cho ngày tiếp theo\n",
    "scaler = MinMaxScaler(feature_range=(0, 1))"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 0. Kết nối Google Drive và Xử lý dữ liệu"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "try:\n",
    "    from google.colab import drive\n",
    "    drive.mount('/content/drive', force_remount=True)\n",
    "    print(\"Đã kết nối với Google Drive thành công!\")\n",
    "except Exception as e:\n",
    "    print(f\"Lỗi hoặc không cần mount Drive: {e}\")\n",
    "\n",
    "# Đường dẫn trên Drive\n",
    "zip_path_in_drive = '/content/drive/MyDrive/Colab Notebooks/Bakery Sales Dataset.zip' \n",
    "\n",
    "def extract_dataset():\n",
    "    # Thử giải nén nếu thấy file zip\n",
    "    zips = glob.glob('*.zip') + [zip_path_in_drive] if os.path.exists(zip_path_in_drive) else glob.glob('*.zip')\n",
    "    for zip_p in zips:\n",
    "        if os.path.exists(zip_p):\n",
    "            with zipfile.ZipFile(zip_p, 'r') as zip_ref:\n",
    "                zip_ref.extractall('./')\n",
    "                print(f\"Đã giải nén: {zip_p}\")\n",
    "\n",
    "extract_dataset()\n",
    "\n",
    "print(\"\\n--- DANH SÁCH FILE HIỆN CÓ ---\")\n",
    "for f in glob.glob('**/*', recursive=True):\n",
    "    if os.path.isfile(f): print(f)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Tải và Tiền xử lý dữ liệu"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def find_and_load_data():\n",
    "    # Danh sách các tên file có khả năng xảy ra theo ảnh fen gửi\n",
    "    possible_files = ['Bakery.csv', 'bakery_sales_revised.csv', 'Bakery Sales.csv']\n",
    "    csv_path = None\n",
    "    \n",
    "    for f in possible_files:\n",
    "        if os.path.exists(f):\n",
    "            csv_path = f\n",
    "            break\n",
    "    \n",
    "    if not csv_path:\n",
    "        # Nếu không thấy các tên trên, bốc đại file csv đầu tiên tìm thấy\n",
    "        all_csvs = glob.glob('**/*.csv', recursive=True)\n",
    "        if all_csvs: csv_path = all_csvs[0]\n",
    "            \n",
    "    if csv_path:\n",
    "        print(f\"Đang dùng file: {csv_path}\")\n",
    "        df = pd.read_csv(csv_path)\n",
    "        df.columns = [c.strip() for c in df.columns]\n",
    "        \n",
    "        # Tự động tìm cột chứa ngày tháng\n",
    "        date_col = None\n",
    "        for col in df.columns:\n",
    "            if 'date' in col.lower():\n",
    "                date_col = col\n",
    "                break\n",
    "        \n",
    "        if date_col:\n",
    "            df[date_col] = pd.to_datetime(df[date_col])\n",
    # Gom nhóm theo ngày và đếm số lượng giao dịch\n",
    "            daily_sales = df.groupby(date_col).size().reset_index(name='Sales')\n",
    "            daily_sales = daily_sales.set_index(date_col)\n",
    "\n",
    "            # LÀM MƯỢT BIỂU ĐỒ (Sử dụng Trung bình trượt 7 ngày)\n",
    "            daily_sales['SMA_7'] = daily_sales['Sales'].rolling(window=7).mean()\n",
    "\n",
    "            # THÊM CÁC ĐẶC TRƯNG MỚI (Feature Engineering)\n",
    "            daily_sales['DayOfWeek'] = daily_sales.index.dayofweek\n",
    "            daily_sales['IsWeekend'] = daily_sales['DayOfWeek'].apply(lambda x: 1 if x >= 5 else 0)\n",
    "            daily_sales['Month'] = daily_sales.index.month\n",
    "\n",
    "            print(f\"Đã tải {len(daily_sales)} ngày dữ liệu.\")\n",
    "            plt.figure(figsize=(15,7))\n",
    "            plt.plot(daily_sales['Sales'], alpha=0.3, label='Dữ liệu gốc (Nhiều nhiễu)')\n",
    "            plt.plot(daily_sales['SMA_7'], color='red', linewidth=2, label='Xu hướng (Trung bình 7 ngày)')\n",
    "            plt.title(f'Biểu đồ Doanh số hàng ngày - {csv_path}', fontsize=16)\n",
    "            plt.xlabel('Ngày', fontsize=12)\n",
    "            plt.ylabel('Số lượng giao dịch', fontsize=12)\n",
    "            plt.legend()\n",
    "            plt.grid(True, linestyle='--', alpha=0.5)\n",
    "            plt.show()\n",
    "            \n",
    "            # Trả về các cột đã được feature engineering\n",
    "            return daily_sales[['Sales', 'DayOfWeek', 'IsWeekend', 'Month']]\n",

    "        else:\n",
    "            print(\"CẢNH BÁO: Không tìm thấy cột ngày tháng (Date)!\")\n",
    "            display(df.head())\n",
    "    else:\n",
    "        print(\"KHÔNG TÌM THẤY FILE CSV NÀO!\")\n",
    "    return None\n",
    "\n",
    "daily_sales = find_and_load_data()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Chuẩn bị dữ liệu cho LSTM"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def create_dataset(data, look_back):\n",
    "    scaled_data = scaler.fit_transform(data)\n",
    "    X, y = [], []\n",
    "    for i in range(len(scaled_data) - look_back):\n",
    "        X.append(scaled_data[i:(i + look_back), :])\n",
    "        y.append(scaled_data[i + look_back, 0])\n",
    "    X, y = np.array(X), np.array(y)\n",
    "    return X, y\n",
    "\n",
    "if daily_sales is not None:\n",
    "    X, y = create_dataset(daily_sales.values, look_back)\n",
    "    train_size = int(len(X) * 0.8)\n",
    "    X_train, X_test = X[:train_size], X[train_size:]\n",
    "    y_train, y_test = y[:train_size], y[train_size:]\n",
    "    print(f\"Dữ liệu huấn luyện: {X_train.shape}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Xây dựng và Huấn luyện mô hình"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "if 'X_train' in locals():\n",
    "    model = Sequential([\n",
    "        Bidirectional(LSTM(64, return_sequences=True), input_shape=(look_back, X_train.shape[2])),\n",
    "        Dropout(0.3),\n",
    "        Bidirectional(LSTM(64, return_sequences=False)),\n",
    "        Dropout(0.3),\n",
    "        Dense(32, activation='relu'),\n",
    "        Dense(1)\n",
    "    ])\n",
    "    model.compile(optimizer='adam', loss='mean_squared_error')\n",
    "    \n",
    "    early_stop = EarlyStopping(monitor='val_loss', patience=10, restore_best_weights=True)\n",
    "    reduce_lr = ReduceLROnPlateau(monitor='val_loss', factor=0.5, patience=5, min_lr=1e-5)\n",
    "    \n",
    "    model.fit(X_train, y_train, batch_size=32, epochs=100, \n",
    "              validation_data=(X_test, y_test), callbacks=[early_stop, reduce_lr], verbose=1)\n",
    "    \n",
    "    plt.plot(model.history.history['loss'], label='train')\n",
    "    plt.plot(model.history.history['val_loss'], label='test')\n",
    "    plt.legend()\n",
    "    plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Dự báo tương lai"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "if 'model' in locals():\n",
    "    # Dự báo ngày mai\n",
    "    last_days = daily_sales.values[-look_back:]\n",
    "    last_days_scaled = scaler.transform(last_days)\n",
    "    X_input = last_days_scaled.reshape(1, look_back, X_train.shape[2])\n",
    "    \n",
    "    future_prediction_scaled = model.predict(X_input)\n",
    "    \n",
    "    # Tạo mảng dummy để inverse_transform (vì scaler fit trên 4 cột)\n",
    "    dummy = np.zeros((1, daily_sales.shape[1]))\n",
    "    dummy[0, 0] = future_prediction_scaled[0][0]\n",
    "    future_val = scaler.inverse_transform(dummy)[0, 0]\n",
    "    \n",
    "    print(f\"\\n===> DỰ BÁO DOANH SỐ NGÀY MAI: {future_val:.2f}\")\n",
    "    \n",
    "    model.save('bakery_model_advanced.h5')"
   ]
  }
 ],
